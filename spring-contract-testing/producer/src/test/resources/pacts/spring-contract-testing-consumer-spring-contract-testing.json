{
  "consumer": {
    "name": "spring-contract-testing-consumer"
  },
  "interactions": [
    {
      "description": "a request for order 1",
      "key": "b706c5b",
      "pending": false,
      "providerStates": [
        {
          "name": "order 1 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/orders/1"
      },
      "response": {
        "body": {
          "content": {
            "customerId": "customer-1",
            "id": 1,
            "total": 49.99
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.customerId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for order 999",
      "key": "213bec34",
      "pending": false,
      "providerStates": [
        {
          "name": "order 999 does not exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/orders/999"
      },
      "response": {
        "status": 404
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for all orders",
      "key": "f36585cd",
      "pending": false,
      "providerStates": [
        {
          "name": "orders exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/orders"
      },
      "response": {
        "body": {
          "content": [
            {
              "customerId": "customer-1",
              "id": 1,
              "total": 49.99
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].customerId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.0"
    },
    "pactSpecification": {
      "version": "4.0"
    },
    "plugins": [

    ]
  },
  "provider": {
    "name": "spring-contract-testing"
  }
}
